Build qiskit 2.6.2 for WebAssembly (Pyodide 314, wasm32-unknown-emscripten).
Ported from QisPlay's qiskit-2.5.2 patch (https://github.com/kriss-u/QisPlay, MIT).

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -22,7 +22,8 @@
 num-bigint = "0.4"
 num-complex = { version = "0.4", features = ["bytemuck"] }
 nalgebra = "0.35"
-faer = "0.24"
+# No rayon: its spindle thread pool needs atomic-wait, which lacks an emscripten backend.
+faer = { version = "0.24", default-features = false, features = ["std", "sparse-linalg", "rand"] }
 numpy = "0.29"
 ndarray = "0.17"
 smallvec = "1.15"
--- a/crates/circuit/Cargo.toml
+++ b/crates/circuit/Cargo.toml
@@ -32,7 +32,6 @@
 nom.workspace = true
 nom-unicode.workspace = true
 nom-language.workspace = true
-crossterm = "0.29.0"
 unicode-width = "0.2"
 ahash = "0.8.12"
 unicode-segmentation = "1.13"
@@ -40,6 +39,10 @@
 lexical-write-float = "1.0.6"
 indexmap.workspace = true
 
+# crossterm's event loop depends on mio, which does not support WebAssembly.
+[target.'cfg(not(target_os = "emscripten"))'.dependencies]
+crossterm = "0.29.0"
+
 [dependencies.pyo3]
 workspace = true
 features = ["hashbrown", "indexmap", "num-complex", "num-bigint", "smallvec", "py-clone"]
