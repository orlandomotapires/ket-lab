    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_qubit",
        "source_marker",
        "target_qubit"
      ],
      "properties": {
        "source_qubit": {
          "type": "integer",
          "minimum": 0
        },
        "source_marker": {
          "type": "string",
          "minLength": 1,
          "description": "Code snippet; the source state is the one at the line where it appears"
        },
        "target_qubit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prediction_answer": {
      "type": "integer",
      "minimum": 0
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qubits"
      ],
      "description": "Register shown in the amplitude views, gauges and histogram",
      "properties": {
        "qubits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "modular": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "N"
      ],
      "properties": {
        "a": {
          "type": "integer",
          "minimum": 2
        },
        "N": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "framework": {
      "enum": [
        "qiskit",
        "pennylane",
        "python"
      ],
      "description": "pennylane: the circuit is a QNode; python: lesson without a circuit (math kit), shows the variables"
    },
    "qnode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Which QNode to draw and with which learner variables as arguments"
    },
    "live": {
      "type": "boolean",
      "description": "false: runs only from the button (slow training runs)"
    },
    "timeout": {
      "type": "number",
      "minimum": 1,
      "maximum": 30,
      "description": "Seconds per run"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "options",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2
          },
          "default": {}
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "description": "Further reading: at least one theoretical (book/article) and one practical (course/tutorial)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "authors",
          "location",
          "url"
        ],
        "properties": {
          "kind": {
            "enum": [
              "book",
              "paper",
              "course",
              "tutorial"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "description": "Where to read, precisely: chapter/section, title and pages (books) or lesson and section title (courses)"
          }
        }
      }
    },
