{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "track",
    "num_qubits",
    "default_visualizer",
    "available_visualizers",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]\\.[0-9]+$"
    },
    "track": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "num_qubits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "max_qubits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "default_visualizer": {
      "$ref": "#/$defs/visualizer"
    },
    "available_visualizers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/visualizer"
      }
    },
    "validation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "state_fidelity"
            },
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "allowed_gates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_gates": {
              "type": "integer",
              "minimum": 1
            },
            "forbidden_pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "expected_variables": {
              "type": "object",
              "description": "Learner-code variables checked after the main validation"
            },
            "required_gates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gate_counts": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "description": "Exact number of times each gate must appear (e.g. one oracle query)"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "counts_distribution"
            },
            "shots": {
              "type": "integer",
              "minimum": 100,
              "maximum": 8192
            },
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "allowed_gates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "max_gates": {
              "type": "integer",
              "minimum": 1
            },
            "forbidden_pairs": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "expected_variables": {
              "type": "object",
              "description": "Learner-code variables checked after the main validation"
            },
            "required_gates": {
              "type": "array",
              "items": {
