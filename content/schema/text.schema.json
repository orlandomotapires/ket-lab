{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson texts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "mission",
    "hints",
    "objectives"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options",
        "explanation"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_label",
        "target_label"
      ],
      "properties": {
        "source_label": {
          "type": "string"
        },
        "target_label": {
          "type": "string"
        }
      }
    },
    "views": {
      "type": "object",
      "description": "Optional labels for the viewer tabs",
      "additionalProperties": {
        "type": "string"
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Messages from the lesson's own validation (check.py), by key"
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "options"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "What the learner will be able to do at the end of the lesson; each objective is exercised by the mission, a hint or the prediction"
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "hints"
      ],
      "properties": {
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
