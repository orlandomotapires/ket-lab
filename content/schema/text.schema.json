{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Textos de uma lição em um idioma",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "summary",
    "mission",
    "hints"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "hints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options",
        "explanation"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_label",
        "target_label"
      ],
      "properties": {
        "source_label": {
          "type": "string"
        },
        "target_label": {
          "type": "string"
        }
      }
    },
    "views": {
      "type": "object",
      "description": "Rótulos opcionais das abas do visualizador",
      "additionalProperties": {
        "type": "string"
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Mensagens da validação própria (check.py), por chave"
    },
    "controls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "options"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
