# Hosted simulation engine. It runs learner code: the container is the security
# boundary (see README.md and docker-compose.yml).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /srv

COPY engine/pyproject.toml engine/pyproject.toml
COPY engine/qlp_engine engine/qlp_engine
RUN pip install ./engine

COPY content content

# Unprivileged user; the filesystem is read-only in the compose file.
RUN useradd --system --uid 10001 --no-create-home qlp
USER qlp

EXPOSE 8765
ENTRYPOINT ["python", "-m", "qlp_engine", "--public", "--host", "0.0.0.0", "--port", "8765", "--content-dir", "/srv/content"]
CMD ["--workers", "4", "--max-connections", "200"]
