{
  "name": "ket-lab",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:engine && npm run test:app",
    "test:engine": "cd engine && .venv/bin/python -m mypy && .venv/bin/python -m pytest -q",
    "test:app": "npm --prefix app run typecheck && npm --prefix app test",
    "build:app": "npm --prefix app run build",
    "test:e2e": "npm --prefix app run e2e"
  },
  "license": "MIT"
}
